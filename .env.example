# Environment variables for Next.js + Firebase
# Note: For local development, prefer using .env.local (git-ignored). This .env file is committed and should NOT contain real secrets.

# Public keys (exposed to browser). Safe to prefix with NEXT_PUBLIC_
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# If you use Google OAuth on a custom backend (not Firebase), set these in .env.local (not committe
# Optional: set your site URL for OAuth redirects (e.g., http://localhost:3000 or https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n Automation Webhook URL (Production / Testing)
N8N_WEBHOOK_URL=https://<your-n8n-subdomain>.tamdan.online/webhook/922f2179-c4b3-45f2-bc82-839447024457

# Telegram Bot Configuration (Serverless)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Public anon key is safe to expose to the browser via NEXT_PUBLIC_ 
